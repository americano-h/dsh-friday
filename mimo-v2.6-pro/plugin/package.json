{
  "name": "dsh-friday",
  "version": "0.5.0",
  "private": true,
  "description": "Inbox quick answers for DSH: a hotkey overlay for lightweight web-search-only conversations, sedimented into an Inbox sidebar panel that can be resumed, searched, and upgraded into real workspace tasks.",
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "src/**/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "build": "node ../scripts/build-client.mjs",
    "check": "node ../scripts/check.mjs",
    "test": "node --test ../tests/*.test.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-shortcuts"
      ]
    }
  }
}
